# ---------------------------------------------------------------------------
# 프론트엔드 (브라우저로 노출됨 — anon key 외에는 절대 넣지 말 것)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# GitHub Pages 배포 경로. 저장소 이름과 맞춘다. 사용자 페이지면 "/" 로 둔다.
VITE_BASE_PATH=/choco-ads-dashboard/

# ---------------------------------------------------------------------------
# Supabase Edge Function 전용 (supabase secrets set 으로 등록, 깃에 올리지 말 것)
# ---------------------------------------------------------------------------
# mock = 가짜 데이터로 파이프라인 테스트 / live = 실제 광고 API 호출
AD_API_MODE=mock
AD_API_BASE_URL=https://api.searchad.naver.com
AD_API_KEY=
AD_API_SECRET=
AD_API_CUSTOMER_ID=
AD_API_ACCOUNT_ID=
AD_API_REPORT_PATH=/stats
